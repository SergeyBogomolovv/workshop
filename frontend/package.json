{
  "name": "workshop-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b && eslint .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format:check": "prettier --check --ignore-path ../.prettierignore src scripts \"*.ts\" \"*.js\" \"*.json\" index.html ../compose*.yml ../.prettierrc.json",
    "validate:css": "node scripts/validate-css.mjs",
    "format": "prettier --write --ignore-path ../.prettierignore src scripts \"*.ts\" \"*.js\" \"*.json\" index.html ../compose*.yml ../.prettierrc.json"
  },
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/css-tree": "3.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "css-tree": "3.2.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "html-validate": "11.0.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
